{
  "name": "roadrunner/api-dto",
  "type": "library",
  "description": "Pre-generated PHP DTOs for the RoadRunner API protocol buffers, used to make RPC calls to the RoadRunner server",
  "keywords": [
    "roadrunner",
    "api",
    "dto",
    "protobuf",
    "rpc",
    "temporal"
  ],
  "license": "MIT",
  "homepage": "https://roadrunner.dev/",
  "support": {
    "docs": "https://docs.roadrunner.dev",
    "issues": "https://github.com/roadrunner-server/roadrunner/issues",
    "source": "https://github.com/roadrunner-php/roadrunner-api-dto",
    "forum": "https://forum.roadrunner.dev",
    "chat": "https://discord.gg/V6EK4he"
  },
  "authors": [
    {
      "name": "Pavel Buchnev",
      "homepage": "https://github.com/butschster"
    },
    {
      "name": "Aleksei Gagarin",
      "homepage": "https://github.com/roxblnfk"
    },
    {
      "name": "RoadRunner Community",
      "homepage": "https://github.com/roadrunner-server/roadrunner/graphs/contributors"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/roadrunner-server"
    }
  ],
  "require": {
    "php": "^8.1",
    "google/protobuf": "^4.31.1||^5.34.0"
  },
  "replace": {
    "roadrunner-php/roadrunner-api-dto": "self.version"
  },
  "suggest": {
    "google/common-protos": "Required for Temporal API"
  },
  "conflict": {
    "temporal/sdk": "<2.20"
  },
  "scripts": {
    "build": "./generate.sh"
  },
  "autoload": {
    "psr-4": {
      "RoadRunner\\": "generated/RoadRunner",
      "GPBMetadata\\": "generated/GPBMetadata",
      "Temporal\\": "generated/Temporal"
    }
  }
}
